# Listick settings: copy this file to .env, set TMDB_ACCESS_TOKEN, and fill in anything else you want to use.

# ---------- required ----------
# your TMDB API Read Access Token (free: themoviedb.org › Settings › API)
TMDB_ACCESS_TOKEN=

# ---------- on the internet ----------
# the URL you open Listick at: http://localhost:3000, or your domain (https://listick.example.com). Using more than one?
# List them comma-separated, the main one first
APP_ORIGIN=http://localhost:3000
# only if more than one reverse proxy sits in front of Listick, for example Cloudflare and then your own proxy: 2
LISTICK_TRUSTED_PROXIES=
# your admin account, created on the first start. Set these before putting Listick on the internet; otherwise whoever
# opens it first becomes the admin. Everyone else joins by invite link (Settings › Users)
LISTICK_OWNER_NAME=
LISTICK_OWNER_PASSWORD=
LISTICK_OWNER_EMAIL=

# ---------- optional features: each is off until you set it ----------
# IMDb, Rotten Tomatoes and Metacritic scores (a free key from omdbapi.com)
OMDB_API_KEY=
# MyAnimeList scores, and MyAnimeList's ranking for the anime rows instead of Kitsu's (a Client ID from myanimelist.net › API)
MAL_CLIENT_ID=
# MAL_CLIENT_ID also turns on Sync to MyAnimeList (Settings › Connections): the app's redirect <APP_ORIGIN>/api/lists/done/mal;
# the secret only for a web-type app
MAL_CLIENT_SECRET=
# Sync your anime progress to AniList (Settings › Connections): an API client at anilist.co/settings/developer, redirect
# <APP_ORIGIN>/api/lists/done/anilist
ANILIST_CLIENT_ID=
ANILIST_CLIENT_SECRET=
# TheTVDB's TV categories for lists (food, travel, game shows…), and episode names, stories and images TMDB lacks (a key from
# thetvdb.com/api-information; free under their revenue limit, with a credit)
TVDB_API_KEY=
# password-reset and confirmation emails through Resend (without them, an admin resets passwords)
RESEND_API_KEY=
MAIL_FROM=
# a Cloudflare Turnstile captcha on sign-in, sign-up and password reset
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET=
# set to on for the weather in the top bar (Open-Meteo, no key; each browser asks for its location)
LISTICK_WEATHER=
# sends errors (API failures, failed jobs and imports) to a webhook that takes { content }, such as a Discord webhook
ALERT_WEBHOOK=

# ---------- advanced ----------
# the name shown in the browser tab, on the home screen, in emails and on the sign-in page (default Listick)
APP_NAME=
# your time zone, for dates, stats and the daily row rebuild at 18:00
TZ=UTC
# the password of the bundled database (Docker Compose only; it isn't reachable from outside; default listick)
POSTGRES_PASSWORD=
# your own Postgres instead of the bundled one: the full connection string
# DATABASE_URL=postgres://listick:password@localhost:5432/listick
# database connections per process (default 10; use 1 for a web app on a serverless host)
# DATABASE_POOL_MAX=
# signs sign-in sessions; generated and stored in the database unless you set it. Set it yourself if the web app and the
# worker run on separate hosts: openssl rand -base64 32
BETTER_AUTH_SECRET=
# an email address sent along with requests to the data sources (Wikidata asks for one)
LISTICK_CONTACT=
# background jobs to turn off, comma-separated (for example rows)
LISTICK_DISABLE_JOBS=
# how many users' Stremio data the worker refreshes at once (default 4)
LIVE_CONCURRENCY=
